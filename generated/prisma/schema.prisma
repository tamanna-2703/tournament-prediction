// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js" // Add the -js at the end
  output   = "../../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * ===============
 * ENUMS
 * ===============
 */

enum UserRole {
  ADMIN
  USER
}

enum ContestStatus {
  UPCOMING
  LIVE
  LOCKED
  COMPLETED
}

enum MatchResult {
  TEAM_A_WIN
  TEAM_B_WIN
  TIE
  NO_RESULT
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum TransactionReason {
  CONTEST_ENTRY
  PRIZE_WIN
  NEW_USER_BONUS
}

/**
 * =================
 * USER & WALLET
 * =================
 */
model User {
  id    String   @id @default(uuid())
  email String   @unique
  role  UserRole @default(USER)

  wallet             Wallet?
  predictions        Prediction[]
  transactions       WalletTransaction[]
  leaderboardEntries LeaderboardEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Wallet {
  id      String @id @default(uuid())
  userId  String @unique
  balance Int    @default(0)

  user         User                @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletTransaction {
  id       String @id @default(uuid())
  userId   String
  walletId String

  amount Int
  type   TransactionType
  reason TransactionReason

  referenceId String?

  user   User   @relation(fields: [userId], references: [id])
  wallet Wallet @relation(fields: [walletId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([walletId])
}

/**
 * =================
 * SPORTS & TEAMS
 * =================
 */

model Sport {
  id   String @id @default(uuid())
  name String @unique

  tournaments Tournament[]
  teams       Team[]
}

model Team {
  id      String @id @default(uuid())
  name    String
  sportId String

  sport          Sport   @relation(fields: [sportId], references: [id])
  matchesAsTeamA Match[] @relation("TeamA")
  matchesAsTeamB Match[] @relation("TeamB")

  @@unique([name, sportId])
}

/**
 * =========================
 * TOURNAMENT / CONTEST / MATCH
 * =========================
 */

model Tournament {
  id       String @id @default(uuid())
  name     String
  sportId  String
  entryFee Int

  sport    Sport     @relation(fields: [sportId], references: [id])
  contests Contest[]

  createdAt DateTime @default(now())
}

model Contest {
  id           String @id @default(uuid())
  tournamentId String

  startTime DateTime
  endTime   DateTime
  status    ContestStatus @default(UPCOMING)

  prizePool Int @default(0)

  tournament  Tournament         @relation(fields: [tournamentId], references: [id])
  matches     Match[]
  predictions Prediction[]
  leaderboard LeaderboardEntry[]

  createdAt DateTime @default(now())

  @@index([tournamentId])
}

model Match {
  id        String @id @default(uuid())
  contestId String

  teamAId String
  teamBId String

  startTime DateTime
  endTime   DateTime?

  result MatchResult?

  contest Contest @relation(fields: [contestId], references: [id])

  teamA Team @relation("TeamA", fields: [teamAId], references: [id])

  teamB Team @relation("TeamB", fields: [teamBId], references: [id])

  predictions Prediction[]

  @@index([contestId])
}

/**
 * =========================
 * PREDICTIONS & LEADERBOARD
 * =========================
 */

model Prediction {
  id        String @id @default(uuid())
  userId    String
  matchId   String
  contestId String

  predictedResult MatchResult
  points          Int         @default(0)

  user    User    @relation(fields: [userId], references: [id])
  match   Match   @relation(fields: [matchId], references: [id])
  contest Contest @relation(fields: [contestId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, matchId])
  @@index([contestId])
}

model LeaderboardEntry {
  id        String @id @default(uuid())
  contestId String
  userId    String

  score Int
  rank  Int
  prize Int @default(0)

  contest Contest @relation(fields: [contestId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@unique([contestId, userId])
  @@index([contestId])
}
